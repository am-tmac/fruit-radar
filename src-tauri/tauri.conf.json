{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "水果雷达",
  "version": "1.0.6-custom.1",
  "identifier": "com.amtmac.fruitradar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "水果雷达",
        "width": 1360,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MjUwQTJGRjYyNzY2NjIKUldSaVppZjJMd29scHZ3WlVTbGJ4YnIzRlBNTVVVQmdod0wzUDVpcjVRQmErZUNwY01ob1Z0R20K",
      "endpoints": [
        "https://github.com/am-tmac/fruit-radar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
